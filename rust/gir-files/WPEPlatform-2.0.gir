      <method name="save_to_keyfile"
              c:identifier="wpe_settings_save_to_keyfile">
        <doc xml:space="preserve"
             filename="Source/WebKit/WPEPlatform/wpe/WPESettings.cpp"
             line="258">Adds settings to a keyfile. Keys are transformed into group names, for example:
