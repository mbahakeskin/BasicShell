      <method name="set_value"
              c:identifier="wpe_settings_set_value"
              throws="1">
        <doc xml:space="preserve"
             filename="Source/WebKit/WPEPlatform/wpe/WPESettings.cpp"
             line="292">If @source is %WPE_SETTINGS_SOURCE_APPLICATION, then the value will not be overwritten by the platform.
This value should always be %WPE_SETTINGS_SOURCE_PLATFORM for platforms themselves. This can cause this
method to return %TRUE even though no setting changes.

To set a value @key must have been registered and @value must be of the correct type.

Any floating reference of @value will be consumed.

Setting @value to %NULL will reset it to the default.

On a value being changed it will emit [signal@WPESettings::changed].</doc>
        <source-position filename="Source/WebKit/WPEPlatform/wpe/WPESettings.h"
                         line="333"/>
        <return-value transfer-ownership="none">
          <doc xml:space="preserve"
               filename="Source/WebKit/WPEPlatform/wpe/WPESettings.cpp"
               line="312">%FALSE if @error was set, %TRUE otherwise</doc>
          <type name="gboolean" c:type="gboolean"/>
        </return-value>
        <parameters>
          <instance-parameter name="settings" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="Source/WebKit/WPEPlatform/wpe/WPESettings.cpp"
                 line="294">a #WPESettings</doc>
            <type name="Settings" c:type="WPESettings*"/>
          </instance-parameter>
          <parameter name="key" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="Source/WebKit/WPEPlatform/wpe/WPESettings.cpp"
                 line="295">the key to set</doc>
            <type name="utf8" c:type="const char*"/>
          </parameter>
          <parameter name="value"
                     transfer-ownership="none"
                     nullable="1"
                     allow-none="1">
            <doc xml:space="preserve"
                 filename="Source/WebKit/WPEPlatform/wpe/WPESettings.cpp"
                 line="296">the value to set or %NULL</doc>
            <type name="GLib.Variant" c:type="GVariant*"/>
          </parameter>
          <parameter name="source" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="Source/WebKit/WPEPlatform/wpe/WPESettings.cpp"
                 line="297">the source of the settings change</doc>
            <type name="SettingsSource" c:type="WPESettingsSource"/>
          </parameter>
        </parameters>
      </method>
